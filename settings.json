  "window.zoomLevel": 0,
  "editor.cursorBlinking": "blink",
  "editor.cursorStyle": "line",
  "editor.lineHeight": 2,
  "editor.codeLens": true,
  // "catppuccin-icons.hidesExplorerArrows": true,
  // "material-icon-theme.hidesExplorerArrows": true,
  "breadcrumbs.enabled": false,
  // "workbench.statusBar.visible": false,
  /*
    "emmet.includeLanguages": {
        "erb": "html",         // Tell Emmet to treat .erb files as HTML for autocompletion
        "html.erb": "html"     // Ensure Emmet also applies HTML completions in .html.erb files
    },
 */
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.triggerExpansionOnTab": true,
  "sorbet.enabled": true,
  "auto-close-tag.enableAutoCloseTag": true,
  "auto-close-tag.activationOnLanguage": [
    "xml",
    "php",
    "blade",
    "ejs",
    "jinja",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "plaintext",
    "markdown",
    "vue",
    "liquid",
    "erb"
  ],
  "html.format.templating": true,
  "editor.defaultFormatter": "formulahendry.auto-close-tag",
  "editor.wordWrap": "on",
  "eslint.format.enable": true,
  "rubyLsp.linters": [null],

  // All of these settings are scoped only to the Ruby language
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp", // Use the Ruby LSP as the default formatter
    "editor.formatOnSave": false, // Format files automatically when saving
    "editor.tabSize": 2, // Use 2 spaces for indentation
    "editor.insertSpaces": false, // Use spaces and not tabs for indentation
    "editor.semanticHighlighting.enabled": true, // Enable semantic highlighting
    "editor.formatOnType": false // Enable formatting while typing
  },

  "[erb]": {
    "editor.defaultFormatter": "aliariff.vscode-erb-beautify"
    // "editor.formatOnSave": true
  },
  "files.associations": {
    "*.html.erb": "erb" // Ensure .html.erb files keep Ruby highlighting
  },
  "editor.tabSize": 2,
  "editor.stickyTabStops": true,
  "terminal.integrated.gpuAcceleration": "off",
  // "workbench.preferredHighContrastColorTheme": "One Dark Pro",
  "chat.commandCenter.enabled": false,
  "workbench.activityBar.location": "hidden",
  "animations.Active": "Indent",
  "animations.Command-Palette": "Fade",
  "animations.Tabs": "None",
  "html.format.indentInnerHtml": true,
  "workbench.iconTheme": "vscode-great-icons",
  "workbench.colorTheme": "Tokyo Storm Gogh",
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "pgsql.serverGroups": [
    {
      "name": "Servers",
      "id": "A69670F1-B68A-4D3F-9576-9C46D62B86A6",
      "isDefault": true
    }
  ],
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {}
