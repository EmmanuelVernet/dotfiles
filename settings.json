{
  "editor.fontSize": 19,
  "editor.fontFamily": "JetBrainsMonoNL-ExtraLight, Menlo, Monaco, 'Courier New', monospace, Meslo, MesloLGS NF",
  "terminal.integrated.fontSize": 18,
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "workbench.externalBrowser": "chrome",
  "git.autofetch": true,
  "editor.minimap.enabled": false,
  //"terminal.external.osxExec": "iTerm.app",
  //"terminal.explorerKind": "external",
  "code-runner.runInTerminal": true,
  "terminal.explorerKind": "external",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.indent": 12,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.sideBar.location": "right",
  // "workbench.statusBar.visible": false,  // Hides the bottom status bar
  // "editor.folding": false,               // Hides the code folding indicators
  "editor.renderLineHighlight": "none", // Disables the highlight of the active line
  "editor.renderWhitespace": "none", // Hides whitespace markers
  "editor.scrollBeyondLastLine": false, // Prevents unnecessary scrolling
  "explorer.openEditors.visible": 1, // Removes the "Open Editors" section
  "editor.stickyScroll.enabled": false, // Removes sticky scroll on main window
  "editor.scrollbar.horizontal": "hidden", // Hide horizontal scrollbar
  "editor.scrollbar.vertical": "hidden", // Hide vertical scrollbar
  // "editor.overviewRulerBorder": false,
  "editor.scrollbar.useShadows": false, // Disables any shadow effects on the scrollbar
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.bracketPairColorization.enabled": true,
  "workbench.editor.showTabs": "single",
  "workbench.statusBar.visible": true,
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "color-highlight.markRuler": false,
  "editor.glyphMargin": true,
  "editor.showFoldingControls": "mouseover",
  "window.menuBarVisibility": "toggle",
  "workbench.layoutControl.type": "both",

